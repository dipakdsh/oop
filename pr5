Problem Statement : Create a Java program demonstrating single inheritance where a subclass extends a superclass and calls its methods.

package oop123;


class Animal { 
void eat() { 
System.out.println("Animal is eating."); 

} 

void sleep() { 

	System.out.println("Animal is sleeping."); 
} 
} 
class Dog extends Animal { 

	void bark() { 

		System.out.println("Dog is barking."); 
} 
} 
 
public class SingleInheritanceDemo { 
public static void main(String[] args) { 
 
Dog d = new Dog(); 

d.eat(); 
d.sleep(); 

d.bark(); 
} 
}
